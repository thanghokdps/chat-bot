{
  "enabledPlugins": {
    "business-analyst@granbull-internal": false,
    "developers@granbull-internal": false,
    "flash-frontend-dev@granbull-internal": false,
    "security-guidance@claude-plugins-official": false,
    "harness@harness": false,
    "core@harness": true,
    "progress@harness": true,
    "plan@harness": true,
    "review@harness": true,
    "dev@harness": true,
    "ship@harness": true,
    "agent@harness": true,
    "lead@harness": false,
    "guards@harness": false
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/eslint-on-edit.sh"
          }
        ]
      }
    ]
  }
}
