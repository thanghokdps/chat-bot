# Copy to .env and fill in. Names only — never commit values.
DATABASE_URL=postgres://chat:chat@localhost:5432/chat
POSTGRES_PORT=5432               # host port for docker compose Postgres; change both if 5432 is taken

BETTER_AUTH_SECRET=            # openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

OPENAI_API_KEY=
# Model ids: verify against https://api.openai.com/v1/models before changing.
MODEL_PRIMARY=gpt-5
MODEL_FALLBACK=gpt-5-mini
MODEL_PREMIUM=gpt-5
MODEL_CHEAP=gpt-5-nano

TRACING_ENABLED=false
TRACE_CONTENT=false           # true keeps prompt text in traces (PII redacted)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
TRACE_HASH_SECRET=             # HMAC key for user ids in traces

# CopilotKit sends usage telemetry unless disabled.
COPILOTKIT_TELEMETRY_DISABLED=true
