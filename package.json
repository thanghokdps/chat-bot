{
  "name": "chat-ai-plus",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "dev:all": "bash scripts/dev-up.sh",
    "build": "next build",
    "start": "next start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "evals": "vitest run --config evals/vitest.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:purge": "tsx --env-file-if-exists=.env scripts/purge-deleted.ts"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.2",
    "@ag-ui/core": "1.0.2",
    "@ag-ui/langgraph": "0.0.44",
    "@copilotkit/react-core": "1.79.1",
    "@copilotkit/runtime": "1.79.1",
    "@langchain/core": "1.2.20",
    "@langchain/langgraph": "1.5.2",
    "@langchain/openai": "1.6.3",
    "@langfuse/langchain": "6.0.1",
    "@langfuse/otel": "6.0.1",
    "@langfuse/tracing": "6.0.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "better-auth": "1.7.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "langchain": "1.5.18",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.2",
    "eslint-plugin-import-x": "4.17.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "overrides": {
      "@langchain/core": "1.2.20",
      "@langchain/langgraph": "1.5.2",
      "langchain": "1.5.18"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
